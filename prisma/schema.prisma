generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  editor
  partner
  user
}

enum ContentStatus {
  draft
  published
  archived
}

enum ShareKind {
  favorites
  collection
  recipe
}

enum EventType {
  page_view
  time_on_page
  favorite_add
  favorite_remove
  collection_create
  collection_delete
  collection_add
  collection_remove
  share_create
  pdf_export
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(editor)
  partnerId    String?
  partner      Partner?  @relation(fields: [partnerId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Profile (for regular users)
  firstName    String?
  lastName     String?
  username     String?   @unique
  barName      String?
  city         String?

  recipes      Recipe[]  @relation("RecipeCreatedBy")
  prebatches   Prebatch[] @relation("PrebatchCreatedBy")
  drinks       Drink[]   @relation("DrinkCreatedBy")

  favorites    Favorite[]
  collections  Collection[]
  shareLinks   ShareLink[]
  events       Event[]
}

model Favorite {
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@index([recipeId])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]
  shareLinks ShareLink[]

  @@index([userId])
}

model CollectionItem {
  collectionId String
  recipeId     String
  position     Int       @default(0)
  createdAt    DateTime  @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([collectionId, recipeId])
  @@index([recipeId])
}

model ShareLink {
  token        String    @id @default(cuid())
  kind         ShareKind
  lang         String?   // "ru" | "en"
  userId       String
  collectionId String?
  recipeId     String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe       Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([collectionId])
  @@index([recipeId])
}

model Event {
  id          String    @id @default(cuid())
  ts          DateTime  @default(now())
  type        EventType
  path        String
  referrer    String?
  durationMs  Int?

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  anonymousId String
  sessionId   String

  recipeId    String?
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  meta        Json?

  @@index([ts])
  @@index([type])
  @@index([userId])
  @@index([anonymousId])
  @@index([path])
  @@index([recipeId])
}

model Partner {
  id              String   @id
  name            String
  nameEn          String
  isGeneralPartner Boolean @default(false)
  logo            String?
  description     String
  descriptionEn   String
  link            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  drinks          Drink[]
}

model DrinkCategory {
  id            String   @id
  slug          String   @unique
  name          String
  nameEn        String
  icon          String?
  description   String
  descriptionEn String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  drinks        Drink[]
}

model Drink {
  id            String        @id
  categoryId    String
  partnerId     String
  name          String
  nameEn        String
  image         String?
  tagline       String?
  taglineEn     String?
  description   String
  descriptionEn String
  producer      String?
  producerEn    String?
  origin        String?
  originEn      String?
  abv           String?
  volume        String?
  tastingNotes  String?
  serve         String?
  serveEn       String?
  buyUrl        String?
  buyLabel      String?
  buyLabelEn    String?
  purchaseNote  String?
  purchaseNoteEn String?
  recipeHints   String?
  sortOrder     Int           @default(0)
  status        ContentStatus @default(published)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category      DrinkCategory @relation(fields: [categoryId], references: [id])
  partner       Partner       @relation(fields: [partnerId], references: [id])

  createdById   String?
  createdBy     User?         @relation("DrinkCreatedBy", fields: [createdById], references: [id])

  @@index([categoryId])
  @@index([partnerId])
}

model Prebatch {
  id          String        @id @default(cuid())
  name        String
  ingredients String[]
  steps       String[]
  status      ContentStatus @default(published)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdById String?
  createdBy   User?         @relation("PrebatchCreatedBy", fields: [createdById], references: [id])

  recipes     Recipe[]
}

model Recipe {
  id             String        @id @default(cuid())
  slug           String        @unique
  city           String
  lat            Float
  lng            Float

  name           String
  region         String
  author         String
  bar            String
  difficulty     String
  category       String
  barDescription String
  barCity        String
  tags           String[]
  intro          String
  image          String
  method         String
  glass          String
  garnish        String
  ice            String

  prebatchMode   String        @default("text") // text|ref|none
  prebatchText   String?
  prebatchId     String?
  prebatch       Prebatch?     @relation(fields: [prebatchId], references: [id])

  flavorBitter   Int @default(0)
  flavorSweet    Int @default(0)
  flavorSour     Int @default(0)
  flavorSpicy    Int @default(0)
  flavorStrong   Int @default(0)

  ingredients    String[]
  steps          String[]

  authorInstagram String?
  authorTg        String?
  barLink         String?

  status         ContentStatus @default(published)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdById    String?
  createdBy      User?         @relation("RecipeCreatedBy", fields: [createdById], references: [id])

  favorites      Favorite[]
  collectionItems CollectionItem[]
  shareLinks     ShareLink[]
  events         Event[]

  @@index([status])
  @@index([region])
}

